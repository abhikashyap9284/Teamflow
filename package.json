{
  "name": "teamflow-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "auth:diagnose": "node --env-file-if-exists=.env.local scripts/diagnose-auth.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0",
    "zod": "3.25.76",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@electric-sql/pglite": "0.5.9"
  }
}
